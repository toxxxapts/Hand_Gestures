   "source": [
    "## 8. Evaluate the image models on validation and the held-out participant\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9a312051",
   "metadata": {},
   "outputs": [],
   "source": [
    "def predict_dataset(model, dataset):\n",
    "    probabilities = model.predict(dataset, verbose=0)\n",
    "    return probabilities, probabilities.argmax(axis=1)\n",
    "\n",
    "def prepare_model_input(image: Image.Image):\n",
    "    padded = ImageOps.pad(\n",
    "        image.convert('RGB'), IMG_SIZE,\n",
    "        method=Image.Resampling.LANCZOS,\n",
    "        color=(127, 127, 127),\n",
    "    )\n",
    "    return padded, np.asarray(padded, dtype=np.float32)[None, ...]\n",
    "\n",
    "def measure_keras_latency(model, frame, repeats=30):\n",
    "    arrays = []\n",
    "    for path in frame['original_path'].tolist()[:max(1, repeats)]:\n",
    "        with Image.open(path) as image:\n",
    "            _, array = prepare_model_input(ImageOps.exif_transpose(image))\n",
    "        arrays.append(array)\n",
    "    _ = model(arrays[0], training=False)\n",
    "    times = []\n",
    "    for array in arrays:\n",
    "        start = time.perf_counter()\n",
    "        _ = model(array, training=False)\n",
    "        times.append((time.perf_counter() - start) * 1000)\n",
    "    return float(np.mean(times))\n",
    "\n",
    "def metric_row(name, y_true, y_pred, latency_ms=np.nan):\n",
    "    precision, recall, f1, _ = precision_recall_fscore_support(\n",
    "        y_true, y_pred,\n",
    "        labels=list(range(len(CLASS_NAMES))),\n",
    "        average='macro', zero_division=0,\n",
    "    )\n",
    "    return {\n",
    "        'model': name,\n",
    "        'accuracy': accuracy_score(y_true, y_pred),\n",
    "        'precision_macro': precision,\n",
    "        'recall_macro': recall,\n",
    "        'f1_macro': f1,\n",
    "        'avg_latency_ms': latency_ms,\n",
    "    }\n",
    "\n",
    "def evaluate_keras_model(name, filename):\n",
    "    model = keras.models.load_model(MODELS_DIR / filename, compile=False)\n",
    "    val_probabilities, val_predictions = predict_dataset(model, val_ds)\n",
    "    test_probabilities, test_predictions = predict_dataset(model, test_ds)\n",
    "    val_row = metric_row(name, val_df['label'].to_numpy(), val_predictions)\n",
    "    test_row = metric_row(\n",
    "        name, test_df['label'].to_numpy(), test_predictions,\n",
    "        measure_keras_latency(model, test_df),\n",
    "    )\n",
    "    print('\\nMODEL:', name)\n",
    "    print(classification_report(\n",
    "        test_df['label'], test_predictions,\n",
    "        labels=list(range(len(CLASS_NAMES))),\n",
    "        target_names=CLASS_NAMES, zero_division=0, digits=3,\n",
    "    ))\n",
    "    slug = name.lower().replace(' ', '_').replace('-', '_')\n",
    "    pd.DataFrame(classification_report(\n",
    "        test_df['label'], test_predictions,\n",
    "        labels=list(range(len(CLASS_NAMES))),\n",
    "        target_names=CLASS_NAMES, zero_division=0, output_dict=True,\n",
    "    )).transpose().to_csv(TABLES_DIR / f'{slug}_classification_report.csv')\n",
    "    fig, ax = plt.subplots(figsize=(7, 6))\n",
    "    ConfusionMatrixDisplay.from_predictions(\n",
    "        test_df['label'], test_predictions,\n",
    "        labels=list(range(len(CLASS_NAMES))), display_labels=CLASS_NAMES,\n",
    "        cmap='Blues', xticks_rotation=30, colorbar=False, ax=ax,\n",
    "    )\n",
    "    ax.set_title(f'{name}: held-out participant')\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(FIGURES_DIR / f'{slug}_confusion_matrix.png', dpi=180)\n",
    "    plt.show()\n",
    "    return {\n",
    "        'model': model,\n",
    "        'validation_row': val_row,\n",
    "        'test_row': test_row,\n",
    "        'validation_probabilities': val_probabilities,\n",
    "        'validation_predictions': val_predictions,\n",
    "        'test_probabilities': test_probabilities,\n",
    "        'test_predictions': test_predictions,\n",
    "    }\n",
    "\n",
    "keras_outputs = {}\n",
    "for model_name, filename in [\n",
    "    ('Baseline CNN', 'baseline_cnn.keras'),\n",
    "    ('MobileNetV2 frozen', 'mobilenet_frozen.keras'),\n",
    "    ('MobileNetV2 fine-tuned', 'mobilenet_finetuned.keras'),\n",
    "]:\n",
    "    keras_outputs[model_name] = evaluate_keras_model(model_name, filename)\n",
    "\n",
    "validation_results = pd.DataFrame([v['validation_row'] for v in keras_outputs.values()])\n",
    "test_results = pd.DataFrame([v['test_row'] for v in keras_outputs.values()])\n",
    "validation_results.to_csv(TABLES_DIR / 'validation_image_models.csv', index=False)\n",
    "test_results.to_csv(TABLES_DIR / 'test_image_models.csv', index=False)\n",
    "display(validation_results.sort_values('f1_macro', ascending=False).round(4))\n",
    "display(test_results.sort_values('f1_macro', ascending=False).round(4))\n"
   ]
  },
