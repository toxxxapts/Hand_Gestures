   "source": [
    "## 3. Participant-aware split\n",
    "\n",
    "`person_003` is never used for model selection or training. Images from `person_001` and `person_002` form the development set, which is stratified into train and validation subsets. This design reports both an easy in-domain validation result and a harder unseen-person test result.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "19bee561",
   "metadata": {},
   "outputs": [],
   "source": [
    "assert HOLDOUT_PERSON in set(df['person']), f'Missing {HOLDOUT_PERSON}'\n",
    "\n",
    "test_df = df[df['person'] == HOLDOUT_PERSON].copy().reset_index(drop=True)\n",
    "development_df = df[df['person'] != HOLDOUT_PERSON].copy().reset_index(drop=True)\n",
    "\n",
    "train_df, val_df = train_test_split(\n",
    "    development_df,\n",
    "    test_size=0.20,\n",
    "    stratify=development_df['label'],\n",
    "    random_state=SEED,\n",
    ")\n",
    "train_df = train_df.reset_index(drop=True)\n",
    "val_df = val_df.reset_index(drop=True)\n",
    "\n",
    "for split_name, frame in [('train', train_df), ('validation', val_df), ('test', test_df)]:\n",
    "    assert set(frame['label']) == set(range(len(CLASS_NAMES))), f'{split_name} misses a class.'\n",
    "\n",
    "manifest = pd.concat([\n",
    "    train_df.assign(split='train'),\n",
    "    val_df.assign(split='validation'),\n",
    "    test_df.assign(split='test'),\n",
    "], ignore_index=True)\n",
    "assert manifest['hash'].nunique() == len(manifest), 'Exact duplicate leakage remains.'\n",
    "manifest.to_csv(TABLES_DIR / 'split_manifest.csv', index=False)\n",
    "\n",
    "split_counts = pd.crosstab(manifest['class_name'], manifest['split']).reindex(\n",
    "    index=CLASS_NAMES, columns=['train', 'validation', 'test'], fill_value=0\n",
    ")\n",
    "display(split_counts)\n",
    "print('Train:', len(train_df), sorted(train_df['person'].unique()))\n",
    "print('Validation:', len(val_df), sorted(val_df['person'].unique()))\n",
    "print('Held-out test:', len(test_df), sorted(test_df['person'].unique()))\n",
    "split_counts.to_csv(TABLES_DIR / 'split_counts.csv')\n",
    "\n",
    "weights = compute_class_weight(\n",
    "    class_weight='balanced',\n",
    "    classes=np.arange(len(CLASS_NAMES)),\n",
    "    y=train_df['label'].to_numpy(),\n",
    ")\n",
    "CLASS_WEIGHTS = {i: float(value) for i, value in enumerate(weights)}\n",
    "print('Class weights:', CLASS_WEIGHTS)\n"
   ]
  },
