    "## 10. Extract landmark features and report detection coverage\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b69a6666",
   "metadata": {},
   "outputs": [],
   "source": [
    "landmark_cache = {}\n",
    "coverage_rows = []\n",
    "for row_index, item in df.iterrows():\n",
    "    with Image.open(item['original_path']) as image:\n",
    "        image = ImageOps.exif_transpose(image).convert('RGB')\n",
    "        detection = detect_landmarks(image)\n",
    "    landmark_cache[int(item['sample_id'])] = detection\n",
    "    coverage_rows.append({\n",
    "        'sample_id': int(item['sample_id']),\n",
    "        'class_name': item['class_name'],\n",
    "        'person': item['person'],\n",
    "        'detected': detection['image_points'] is not None,\n",
    "        'attempt': detection['attempt'],\n",
    "        'latency_ms': detection['latency_ms'],\n",
    "    })\n",
    "\n",
    "coverage = pd.DataFrame(coverage_rows)\n",
    "coverage.to_csv(TABLES_DIR / 'landmark_detection_coverage.csv', index=False)\n",
    "coverage_summary = coverage.groupby(['person', 'class_name'])['detected'].agg(['sum', 'count', 'mean'])\n",
    "display(coverage_summary)\n",
    "print('Overall detection rate:', f\"{coverage['detected'].mean():.1%}\")\n",
    "print('Average landmark latency:', f\"{coverage['latency_ms'].mean():.1f} ms\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4faf9b3c",
   "metadata": {},
   "source": [
    "## 11. Landmark-feature ablation and custom SVM\n",
    "\n",
    "Two feature sets are compared:\n",
    "\n",
    "- **Coordinates:** 21 normalized 3D points.\n",
    "- **Geometry:** coordinates plus 15 joint angles and 10 fingertip distances.\n",
    "\n",
    "The best feature set and SVM regularization value are selected using validation macro-F1. Missing hand detections are counted as `unknown`, not silently removed from the reported full-set metrics.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a1358c61",
   "metadata": {},
   "outputs": [],
   "source": [
    "def feature_matrix(frame, feature_set):\n",
    "    features, labels, positions, sample_ids = [], [], [], []\n",
    "    for position, item in frame.iterrows():\n",
    "        detection = landmark_cache[int(item['sample_id'])]\n",
    "        if detection['image_points'] is None:\n",
    "            continue\n",
    "        features.append(landmark_feature_vector(detection, feature_set))\n",
    "        labels.append(int(item['label']))\n",
    "        positions.append(position)\n",
    "        sample_ids.append(int(item['sample_id']))\n",
    "    return (\n",
    "        np.asarray(features, dtype=np.float32),\n",
    "        np.asarray(labels, dtype=np.int32),\n",
    "        np.asarray(positions, dtype=np.int32),\n",
    "        np.asarray(sample_ids, dtype=np.int32),\n",
    "    )\n",
    "\n",
    "def full_predictions(model, frame, feature_set):\n",
    "    predictions = np.full(len(frame), -1, dtype=np.int32)\n",
    "    probabilities = np.zeros((len(frame), len(CLASS_NAMES)), dtype=np.float32)\n",
    "    X, _, positions, _ = feature_matrix(frame, feature_set)\n",
    "    if len(X):\n",
    "        detected_predictions = model.predict(X)\n",
    "        detected_probabilities = model.predict_proba(X)\n",
    "        predictions[positions] = detected_predictions\n",
    "        for source_column, class_value in enumerate(model.classes_):\n",
    "            probabilities[positions, int(class_value)] = detected_probabilities[:, source_column]\n",
    "    return probabilities, predictions\n",
    "\n",
    "candidate_rows = []\n",
    "candidate_models = {}\n",
    "for feature_set in ['coordinates', 'geometry']:\n",
    "    X_train, y_train, _, _ = feature_matrix(train_df, feature_set)\n",
    "    for c_value in [1.0, 10.0, 100.0]:\n",
    "        candidate_name = f'{feature_set}_C{c_value:g}'\n",
    "        pipeline = Pipeline([\n",
    "            ('scaler', StandardScaler()),\n",
    "            ('svc', SVC(\n",
    "                C=c_value, kernel='rbf', gamma='scale',\n",
    "                class_weight='balanced', probability=True,\n",
    "                random_state=SEED,\n",
    "            )),\n",
    "        ])\n",
    "        pipeline.fit(X_train, y_train)\n",
    "        _, val_predictions = full_predictions(pipeline, val_df, feature_set)\n",
    "        row = metric_row(\n",
    "            candidate_name,\n",
    "            val_df['label'].to_numpy(),\n",
    "            val_predictions,\n",
    "        )\n",
    "        row['feature_set'] = feature_set\n",
    "        row['C'] = c_value\n",
    "        candidate_rows.append(row)\n",
    "        candidate_models[candidate_name] = pipeline\n",
    "\n",
    "landmark_ablation = pd.DataFrame(candidate_rows).sort_values('f1_macro', ascending=False)\n",
    "landmark_ablation.to_csv(TABLES_DIR / 'landmark_feature_ablation.csv', index=False)\n",
    "display(landmark_ablation.round(4))\n",
    "\n",
    "best_landmark_setting = landmark_ablation.iloc[0]\n",
    "best_landmark_name = best_landmark_setting['model']\n",
    "best_feature_set = best_landmark_setting['feature_set']\n",
    "best_c = float(best_landmark_setting['C'])\n",
    "print('Selected landmark setting:', best_landmark_name)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "000ad5ea",
   "metadata": {},
   "outputs": [],
   "source": [