   "source": [
    "## 5. Training helpers\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5c62b97b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compile_classifier(model, learning_rate):\n",
    "    model.compile(\n",
    "        optimizer=keras.optimizers.Adam(learning_rate=learning_rate),\n",
    "        loss='sparse_categorical_crossentropy',\n",
    "        metrics=['accuracy'],\n",
    "    )\n",
    "\n",
    "def make_callbacks(model_name, patience=5):\n",
    "    return [\n",
    "        keras.callbacks.ModelCheckpoint(\n",
    "            str(MODELS_DIR / f'{model_name}.keras'),\n",
    "            monitor='val_loss', save_best_only=True,\n",
    "        ),\n",
    "        keras.callbacks.EarlyStopping(\n",
    "            monitor='val_loss', patience=patience, restore_best_weights=True,\n",
    "        ),\n",
    "        keras.callbacks.ReduceLROnPlateau(\n",
    "            monitor='val_loss', factor=0.4, patience=2, min_lr=1e-7,\n",
    "        ),\n",
    "    ]\n",
    "\n",
    "def plot_history(history, title, filename):\n",
    "    values = history.history\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(11, 4))\n",
    "    axes[0].plot(values['accuracy'], label='Train')\n",
    "    axes[0].plot(values['val_accuracy'], label='Validation')\n",
    "    axes[0].set_title(f'{title}: accuracy')\n",
    "    axes[0].set_xlabel('Epoch')\n",
    "    axes[0].set_ylabel('Accuracy')\n",
    "    axes[0].legend()\n",
    "    axes[1].plot(values['loss'], label='Train')\n",
    "    axes[1].plot(values['val_loss'], label='Validation')\n",
    "    axes[1].set_title(f'{title}: loss')\n",
    "    axes[1].set_xlabel('Epoch')\n",
    "    axes[1].set_ylabel('Loss')\n",
    "    axes[1].legend()\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(FIGURES_DIR / filename, dpi=180)\n",
    "    plt.show()\n",
    "\n",
    "def maybe_copy_model(filename):\n",
    "    if REUSE_FROM is None:\n",
    "        return False\n",
    "    source = Path(REUSE_FROM) / 'models' / filename\n",
    "    if not source.exists():\n",
    "        return False\n",
    "    shutil.copy2(source, MODELS_DIR / filename)\n",
    "    print('Reused:', source)\n",
    "    return True\n"
   ]
  },
