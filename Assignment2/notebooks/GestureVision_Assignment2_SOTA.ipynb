    "need_frozen = not maybe_copy_model('mobilenet_frozen.keras')\n",
    "need_finetuned = not maybe_copy_model('mobilenet_finetuned.keras')\n",
    "\n",
    "if need_frozen or need_finetuned:\n",
    "    keras.utils.set_random_seed(SEED)\n",
    "    backbone = keras.applications.MobileNetV2(\n",
