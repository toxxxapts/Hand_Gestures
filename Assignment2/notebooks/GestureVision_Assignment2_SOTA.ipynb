   "source": [
    "## 4. TensorFlow datasets and realistic augmentation\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b5b4d36f",
   "metadata": {},
   "outputs": [],
   "source": [
    "def read_image(path, label):\n",
    "    image = tf.io.read_file(path)\n",
    "    image = tf.io.decode_png(image, channels=3)\n",
    "    image = tf.cast(image, tf.float32)\n",
    "    image = tf.ensure_shape(image, (*IMG_SIZE, 3))\n",
    "    return image, tf.cast(label, tf.int32)\n",
    "\n",
    "def make_dataset(frame: pd.DataFrame, training: bool = False):\n",
    "    dataset = tf.data.Dataset.from_tensor_slices((\n",
    "        frame['path'].to_numpy(),\n",
    "        frame['label'].to_numpy(dtype=np.int32),\n",
    "    ))\n",
    "    dataset = dataset.map(read_image, num_parallel_calls=AUTOTUNE).cache()\n",
    "    if training:\n",
    "        dataset = dataset.shuffle(len(frame), seed=SEED, reshuffle_each_iteration=True)\n",
    "    return dataset.batch(BATCH_SIZE).prefetch(AUTOTUNE)\n",
    "\n",
    "train_ds = make_dataset(train_df, training=True)\n",
    "val_ds = make_dataset(val_df)\n",
    "test_ds = make_dataset(test_df)\n",
    "\n",
    "def make_augmentation(name='augmentation'):\n",
    "    augmentation_layers = [\n",
    "        layers.RandomFlip('horizontal'),\n",
    "        layers.RandomRotation(0.08, fill_mode='reflect'),\n",
    "        layers.RandomTranslation(0.10, 0.10, fill_mode='reflect'),\n",
    "        layers.RandomZoom((-0.10, 0.15), (-0.10, 0.15), fill_mode='reflect'),\n",
    "        layers.RandomContrast(0.20),\n",
    "    ]\n",
    "    if hasattr(layers, 'RandomBrightness'):\n",
    "        augmentation_layers.append(layers.RandomBrightness(0.15, value_range=(0, 255)))\n",
    "    return keras.Sequential(augmentation_layers, name=name)\n",
    "\n",
    "preview = make_augmentation('preview_augmentation')\n",
    "images, _ = next(iter(train_ds))\n",
    "plt.figure(figsize=(10, 6))\n",
    "for index in range(8):\n",
    "    augmented = preview(images[:1], training=True)[0]\n",
    "    ax = plt.subplot(2, 4, index + 1)\n",
    "    ax.imshow(np.clip(augmented.numpy(), 0, 255).astype('uint8'))\n",
    "    ax.axis('off')\n",
    "plt.suptitle('Training augmentation examples')\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / 'augmentation_examples.png', dpi=180)\n",
    "plt.show()\n"
   ]
  },
  {
