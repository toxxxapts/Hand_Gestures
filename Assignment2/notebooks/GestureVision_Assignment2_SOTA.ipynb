   "source": [
    "## 9. SOTA component: MediaPipe Hand Landmarker\n",
    "\n",
    "The off-the-shelf MediaPipe gesture head returned `unknown` for nearly all held-out photographs. The useful transferable component is therefore the **Hand Landmarker**, which detects a palm and returns 21 hand landmarks. A new classifier is trained on normalized landmarks from this dataset.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9f08700a",
   "metadata": {},
   "outputs": [],
   "source": [
    "HAND_MODEL_URL = (\n",
    "    'https://storage.googleapis.com/mediapipe-models/hand_landmarker/'\n",
    "    'hand_landmarker/float16/1/hand_landmarker.task'\n",
    ")\n",
    "HAND_MODEL_PATH = MODELS_DIR / 'hand_landmarker.task'\n",
    "if not HAND_MODEL_PATH.exists():\n",
    "    urllib.request.urlretrieve(HAND_MODEL_URL, HAND_MODEL_PATH)\n",
    "\n",
    "hand_options = mp.tasks.vision.HandLandmarkerOptions(\n",
    "    base_options=mp.tasks.BaseOptions(model_asset_path=str(HAND_MODEL_PATH)),\n",
    "    running_mode=mp.tasks.vision.RunningMode.IMAGE,\n",
    "    num_hands=1,\n",
    "    min_hand_detection_confidence=0.25,\n",
    "    min_hand_presence_confidence=0.25,\n",
    ")\n",
    "hand_landmarker = mp.tasks.vision.HandLandmarker.create_from_options(hand_options)\n",
    "print('Hand landmarker model:', HAND_MODEL_PATH)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "49c55569",
   "metadata": {},
   "outputs": [],
   "source": [
    "ANGLE_TRIPLETS = [\n",
    "    (0, 1, 2), (1, 2, 3), (2, 3, 4),\n",
    "    (0, 5, 6), (5, 6, 7), (6, 7, 8),\n",
    "    (0, 9, 10), (9, 10, 11), (10, 11, 12),\n",
    "    (0, 13, 14), (13, 14, 15), (14, 15, 16),\n",
    "    (0, 17, 18), (17, 18, 19), (18, 19, 20),\n",
    "]\n",
    "TIP_IDS = [4, 8, 12, 16, 20]\n",
    "\n",
    "HAND_CONNECTIONS = [\n",
    "    (0, 1), (1, 2), (2, 3), (3, 4),\n",
    "    (0, 5), (5, 6), (6, 7), (7, 8),\n",
    "    (5, 9), (9, 10), (10, 11), (11, 12),\n",
    "    (9, 13), (13, 14), (14, 15), (15, 16),\n",
    "    (13, 17), (17, 18), (18, 19), (19, 20),\n",
    "    (0, 17),\n",
    "]\n",
    "\n",
    "def category_name(category):\n",
    "    return str(\n",
    "        getattr(category, 'category_name', None)\n",
    "        or getattr(category, 'categoryName', None)\n",
    "        or ''\n",
    "    )\n",
    "\n",
    "def detect_landmarks(image: Image.Image):\n",
    "    image = image.convert('RGB')\n",
    "    attempts = [('original', image), ('mirrored', ImageOps.mirror(image))]\n",
    "    total_start = time.perf_counter()\n",
    "    for attempt_name, candidate in attempts:\n",
    "        array = np.ascontiguousarray(np.asarray(candidate, dtype=np.uint8))\n",
    "        mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=array)\n",
    "        result = hand_landmarker.detect(mp_image)\n",
    "        if result.hand_landmarks:\n",
    "            image_points = np.array([\n",
    "                [lm.x, lm.y, lm.z] for lm in result.hand_landmarks[0]\n",
    "            ], dtype=np.float32)\n",
    "            if attempt_name == 'mirrored':\n",
    "                image_points[:, 0] = 1.0 - image_points[:, 0]\n",
    "            if result.hand_world_landmarks:\n",
    "                world_points = np.array([\n",
    "                    [lm.x, lm.y, lm.z] for lm in result.hand_world_landmarks[0]\n",
    "                ], dtype=np.float32)\n",
    "            else:\n",
    "                world_points = image_points.copy()\n",
    "            handedness = ''\n",
    "            if result.handedness and result.handedness[0]:\n",
    "                handedness = category_name(result.handedness[0][0])\n",
    "            return {\n",
    "                'image_points': image_points,\n",
    "                'world_points': world_points,\n",
    "                'handedness': handedness,\n",
    "                'attempt': attempt_name,\n",
    "                'latency_ms': (time.perf_counter() - total_start) * 1000,\n",
    "            }\n",
    "    return {\n",
    "        'image_points': None,\n",
    "        'world_points': None,\n",
    "        'handedness': '',\n",
    "        'attempt': 'not_detected',\n",
    "        'latency_ms': (time.perf_counter() - total_start) * 1000,\n",
    "    }\n",
    "\n",
    "def normalized_coordinates(detection):\n",
    "    points = np.asarray(detection['world_points'], dtype=np.float32).copy()\n",
    "    points -= points[0]  # wrist as origin\n",
    "    if detection['handedness'].lower() == 'left':\n",
    "        points[:, 0] *= -1\n",
    "    scale = float(np.max(np.linalg.norm(points, axis=1)))\n",
    "    if scale < 1e-6:\n",
    "        scale = 1.0\n",
    "    return points / scale\n",
    "\n",
    "def angle_at(a, b, c):\n",
    "    v1, v2 = a - b, c - b\n",
    "    denominator = np.linalg.norm(v1) * np.linalg.norm(v2)\n",
    "    if denominator < 1e-8:\n",
    "        return 0.0\n",
    "    cosine = float(np.clip(np.dot(v1, v2) / denominator, -1.0, 1.0))\n",
    "    return math.acos(cosine) / math.pi\n",
    "\n",
    "def landmark_feature_vector(detection, feature_set='geometry'):\n",
    "    points = normalized_coordinates(detection)\n",
    "    coordinates = points.reshape(-1)\n",
    "    if feature_set == 'coordinates':\n",
    "        return coordinates.astype(np.float32)\n",
    "    angles = np.array([\n",
    "        angle_at(points[a], points[b], points[c])\n",
    "        for a, b, c in ANGLE_TRIPLETS\n",
    "    ], dtype=np.float32)\n",
    "    fingertip_distances = np.array([\n",
    "        np.linalg.norm(points[a] - points[b])\n",
    "        for a, b in combinations(TIP_IDS, 2)\n",
    "    ], dtype=np.float32)\n",
    "    return np.concatenate([coordinates, angles, fingertip_distances]).astype(np.float32)\n",
    "\n",
    "def draw_landmark_points(image, image_points):\n",
    "    output = image.convert('RGB').copy()\n",
    "    if image_points is None:\n",
    "        return output\n",
    "    draw = ImageDraw.Draw(output)\n",
    "    width, height = output.size\n",
    "    points = [\n",
    "        (int(np.clip(x, 0, 1) * width), int(np.clip(y, 0, 1) * height))\n",
    "        for x, y, _ in image_points\n",
    "    ]\n",
    "    for start, end in HAND_CONNECTIONS:\n",
    "        draw.line([points[start], points[end]], fill=(0, 220, 255), width=max(2, width // 180))\n",
    "    radius = max(3, width // 120)\n",
    "    for x, y in points:\n",
    "        draw.ellipse((x-radius, y-radius, x+radius, y+radius), fill=(255, 70, 70))\n",
    "    return output\n"
   ]
  },
