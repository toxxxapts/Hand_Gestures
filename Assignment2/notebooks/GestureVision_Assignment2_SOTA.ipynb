    "## 2. Extract, validate, and standardize the self-collected dataset\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "aaccd809",
   "metadata": {},
   "outputs": [],
   "source": [
    "RAW = Path('/content') / f'gesture_raw_{RUN_ID}'\n",
    "CLEAN = Path('/content') / f'gesture_clean_{RUN_ID}'\n",
    "RAW.mkdir(parents=True, exist_ok=True)\n",
    "CLEAN.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "with zipfile.ZipFile(ZIP_PATH) as archive:\n",
    "    root = RAW.resolve()\n",
    "    for member in archive.infolist():\n",
    "        target = (RAW / member.filename).resolve()\n",
    "        if not target.is_relative_to(root):\n",
    "            raise ValueError(f'Unsafe ZIP member: {member.filename}')\n",
    "    archive.extractall(RAW)\n",
    "\n",
    "def visible_dirs(folder: Path):\n",
    "    return sorted(\n",
    "        p for p in folder.iterdir()\n",
    "        if p.is_dir() and not p.name.startswith('.') and p.name != '__MACOSX'\n",
    "    )\n",
    "\n",
    "DATA_ROOT = RAW\n",
    "while len(visible_dirs(DATA_ROOT)) == 1:\n",
    "    DATA_ROOT = visible_dirs(DATA_ROOT)[0]\n",
    "\n",
    "EXTENSIONS = {'.jpg', '.jpeg', '.png', '.bmp', '.webp', '.tif', '.tiff'}\n",
    "\n",
    "def canonical_class(folder_name: str) -> str:\n",
    "    value = folder_name.lower().replace('-', '_').replace(' ', '_')\n",
    "    if 'open' in value and 'palm' in value:\n",
    "        return 'open_palm'\n",
    "    if 'thumb' in value and 'up' in value:\n",
    "        return 'thumbs_up'\n",
    "    if 'point' in value and 'up' in value:\n",
    "        return 'point_up'\n",
    "    if 'peace' in value or 'victory' in value:\n",
    "        return 'peace'\n",
    "    if 'fist' in value:\n",
    "        return 'fist'\n",
    "    raise ValueError(f'Cannot map class folder: {folder_name}')\n",
    "\n",
    "folder_map = {canonical_class(p.name): p for p in visible_dirs(DATA_ROOT)}\n",
    "assert set(folder_map) == set(CLASS_NAMES), f'Class mapping problem: {folder_map}'\n",
    "\n",
    "records, issues, seen, conflicting_labels = [], [], {}, []\n",
    "for class_name in CLASS_NAMES:\n",
    "    class_dir = folder_map[class_name]\n",
    "    for source_path in sorted(class_dir.rglob('*')):\n",
    "        if not source_path.is_file():\n",
    "            continue\n",
    "        if source_path.suffix.lower() not in EXTENSIONS:\n",
    "            issues.append({'file': str(source_path), 'issue': 'unsupported extension'})\n",
    "            continue\n",
    "        relative = source_path.relative_to(class_dir)\n",
    "        person = relative.parts[0] if len(relative.parts) > 1 else None\n",
    "        try:\n",
    "            with Image.open(source_path) as original:\n",
    "                image = ImageOps.exif_transpose(original).convert('RGB')\n",
    "                width, height = image.size\n",
    "                digest = hashlib.sha256(\n",
    "                    str(image.size).encode('utf-8') + image.tobytes()\n",
    "                ).hexdigest()\n",
    "                if digest in seen:\n",
    "                    previous = seen[digest]\n",
    "                    issues.append({\n",
    "                        'file': str(source_path),\n",
    "                        'issue': f'exact duplicate of {previous[1]} in class {previous[0]}',\n",
    "                    })\n",
    "                    if previous[0] != class_name:\n",
    "                        conflicting_labels.append(str(source_path))\n",
    "                    continue\n",
    "                seen[digest] = (class_name, str(source_path))\n",
    "                clean_path = CLEAN / class_name / f'{digest}.png'\n",
    "                clean_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "                padded = ImageOps.pad(\n",
    "                    image, IMG_SIZE,\n",
    "                    method=Image.Resampling.LANCZOS,\n",
    "                    color=(127, 127, 127),\n",
    "                )\n",
    "                padded.save(clean_path)\n",
    "                records.append({\n",
    "                    'sample_id': len(records),\n",
    "                    'path': str(clean_path),\n",
    "                    'source': str(source_path.relative_to(DATA_ROOT)),\n",
    "                    'original_path': str(source_path),\n",
    "                    'class_name': class_name,\n",
    "                    'label': CLASS_TO_INDEX[class_name],\n",
    "                    'person': person,\n",
    "                    'original_width': width,\n",
    "                    'original_height': height,\n",
    "                    'hash': digest,\n",
    "                })\n",
    "        except Exception as exc:\n",
    "            issues.append({'file': str(source_path), 'issue': str(exc)})\n",
    "\n",
    "df = pd.DataFrame(records)\n",
    "assert len(df) > 0, 'No readable images found.'\n",
    "assert not conflicting_labels, 'Identical images have conflicting class labels.'\n",
    "assert df['person'].notna().all(), 'Some images are outside person folders.'\n",
    "\n",
    "class_counts = df.groupby('class_name').size().reindex(CLASS_NAMES, fill_value=0)\n",
    "person_counts = pd.crosstab(df['class_name'], df['person']).reindex(index=CLASS_NAMES, fill_value=0)\n",
    "\n",
    "display(class_counts.rename('usable_images').to_frame())\n",
    "display(person_counts)\n",
    "print('Usable images:', len(df))\n",
    "print('Excluded files / duplicates:', len(issues))\n",
    "\n",
    "class_counts.to_csv(TABLES_DIR / 'class_counts.csv')\n",
    "person_counts.to_csv(TABLES_DIR / 'person_class_counts.csv')\n",
    "pd.DataFrame(issues, columns=['file', 'issue']).to_csv(TABLES_DIR / 'data_issues.csv', index=False)\n",
    "\n",
    "ax = class_counts.plot.bar(figsize=(8, 4), ylim=(0, max(class_counts) * 1.15))\n",
    "ax.set_title('Usable images per class')\n",
    "ax.set_xlabel('Class')\n",
    "ax.set_ylabel('Images')\n",
    "plt.xticks(rotation=25)\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / 'class_distribution.png', dpi=180)\n",
    "plt.show()\n"
   ]
  },
